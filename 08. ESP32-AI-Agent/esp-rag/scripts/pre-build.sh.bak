#!/usr/bin/env bash
# ── RAG pre-build hook ──────────────────────────────────────────────────────
# Runs before `rag build` to ensure dependencies are available and the
# scripts/rag/ module is importable.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MAIN_PY="$SCRIPT_DIR/main.py"
INIT_PY="$SCRIPT_DIR/__init__.py"

if [ ! -f "$MAIN_PY" ] || [ ! -f "$INIT_PY" ]; then
    echo "[rag hook] ERROR: scripts/rag/ module not found"
    exit 1
fi

# Validate dependencies
python3 -c "
import fitz, bs4, markdownify, sklearn, numpy, tqdm, rank_bm25
import os
# Test that path resolution works
from main import _get_docs_root, _get_index_path, _get_md_dir
print(f'[rag hook] Docs root: {_get_docs_root()}')
print(f'[rag hook] Index path: {_get_index_path()}')
print(f'[rag hook] MD dir: {_get_md_dir()}')
print('[rag hook] All dependencies OK')
" 2>&1 || {
    echo "[rag hook] Missing dependencies. Run: pip3 install pymupdf beautifulsoup4 markdownify scikit-learn numpy tqdm"
    exit 1
}

echo "[rag hook] RAG module ready"